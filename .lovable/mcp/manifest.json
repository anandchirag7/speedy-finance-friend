{
  "version": 1,
  "sdk_version": "0.26.1",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://dgneuqfzpljsujskqhaz.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "paisa",
      "version": "0.1.0",
      "title": "Paisa"
    },
    "tools": [
      {
        "name": "financial_summary",
        "title": "Financial summary",
        "description": "Snapshot of the signed-in user's finances: net worth (assets minus liabilities) and income, expense and savings for a period (defaults to the current month).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "since_date": {
              "description": "YYYY-MM-DD, defaults to the first of the current month.",
              "type": "string"
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_accounts",
        "title": "List accounts",
        "description": "List the signed-in user's financial accounts with balances, institution, currency and whether each is a liability.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "include_inactive": {
              "default": false,
              "description": "Include closed/inactive accounts.",
              "type": "boolean"
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_transactions",
        "title": "List transactions",
        "description": "List the signed-in user's transactions, newest first. Filter by date range, type, account or free-text search on note/merchant.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "default": 25,
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            },
            "since_date": {
              "description": "Only transactions on or after this date (YYYY-MM-DD).",
              "type": "string"
            },
            "until_date": {
              "description": "Only transactions on or before this date (YYYY-MM-DD).",
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": [
                "income",
                "expense",
                "transfer"
              ]
            },
            "account_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "search": {
              "description": "Substring match on note or merchant.",
              "type": "string"
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_categories",
        "title": "List categories",
        "description": "List the signed-in user's income and expense categories, including parent relationships, for categorizing transactions.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "spending_by_category",
        "title": "Spending by category",
        "description": "Aggregate the signed-in user's expenses grouped by category for a period. Defaults to the current month.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "since_date": {
              "description": "YYYY-MM-DD, defaults to the first of the current month.",
              "type": "string"
            },
            "until_date": {
              "description": "YYYY-MM-DD, defaults to today.",
              "type": "string"
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_budgets",
        "title": "List budgets",
        "description": "List the signed-in user's budgets with limits, period and linked categories.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_bills",
        "title": "List bills",
        "description": "List the signed-in user's bills and reminders with due dates, amounts and recurrence.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_goals",
        "title": "List savings goals",
        "description": "List the signed-in user's savings goals with target amounts, saved amounts and target dates.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "create_transaction",
        "title": "Create transaction",
        "description": "Record a new income or expense transaction in the signed-in user's ledger. Use list_accounts and list_categories first to get valid ids.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "account_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "Account the transaction belongs to."
            },
            "type": {
              "type": "string",
              "enum": [
                "income",
                "expense"
              ]
            },
            "amount": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Positive amount in the account's currency."
            },
            "txn_date": {
              "type": "string",
              "description": "Transaction date, YYYY-MM-DD."
            },
            "category_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "merchant": {
              "description": "Payee / merchant name.",
              "type": "string",
              "minLength": 1
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "account_id",
            "type",
            "amount",
            "txn_date"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
